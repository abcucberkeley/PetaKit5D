{
 "name": "fft_spectrum_b04",
 "description": "B04: XR_fftSpectrumComputingWrapper as demo_useful_tools.m calls it (zarr input: the first CamA ch0 demo tile; outSize 1001^3, outPixelSize 0.1 * 0.488 / 1.33, no 3D stack, tasks in the process), MATLAB against the port (default FFT backend) at 4 and 24 threads.",
 "repeats": 5,
 "warmup": 1,
 "setup": ["{python} {src}/benchmarks/tools/fft_spectrum_b04_data.py {work}"],
 "variants": [
  {"id": "ml_t4", "impl": "matlab", "paths": ["benchmarks/tools", "benchmarks/common"],
   "env": {"OMP_NUM_THREADS": "4"}, "code": "fft_spectrum_b04_ml('{work}', 4)", "timeout": 3600},
  {"id": "py_t4", "impl": "python", "script": "benchmarks/tools/fft_spectrum_b04.py",
   "args": ["{work}", "4"], "env": {"OMP_NUM_THREADS": "4"}, "timeout": 3600},
  {"id": "ml_t24", "impl": "matlab", "paths": ["benchmarks/tools", "benchmarks/common"],
   "env": {"OMP_NUM_THREADS": "24"}, "code": "fft_spectrum_b04_ml('{work}', 24)", "timeout": 3600},
  {"id": "py_t24", "impl": "python", "script": "benchmarks/tools/fft_spectrum_b04.py",
   "args": ["{work}", "24"], "env": {"OMP_NUM_THREADS": "24"}, "timeout": 3600}
 ],
 "compare": [{"a": "py_t4", "b": "ml_t4"}, {"a": "py_t24", "b": "ml_t24"}],
 "gate": {"ratio_max": 1.05, "overhead_max": 1.0, "metrics": ["op:dataset@*"]}
}
