{
 "name": "registration_s04_demo",
 "repeats": 5,
 "setup": ["{python} {src}/benchmarks/stitch/registration_s04_setup.py {work} {env[S04_DEMO]}"],
 "variants": [
  {"id": "ml", "impl": "matlab", "paths": ["benchmarks/stitch", "benchmarks/common"],
   "code": "bench_registration_s04('{work}', 'demo', [2, 4, 24], 2)"},
  {"id": "py", "impl": "python", "script": "benchmarks/stitch/registration_s04.py",
   "args": ["{work}", "--case", "demo", "--backend", "permissive", "--threads", "2", "4", "24",
            "--repeats", "2"]},
  {"id": "py_exact", "impl": "python", "script": "benchmarks/stitch/registration_s04.py",
   "args": ["{work}", "--case", "demo", "--backend", "exact", "--threads", "2", "4", "24",
            "--repeats", "2"],
   "env": {"PETAKIT5D_FFTW": "{env[S04_FFTW]}"}, "when": "S04_FFTW"}
 ],
 "compare": [{"a": "py", "b": "ml"}, {"a": "py_exact", "b": "ml"}],
 "gate": {"ratio_max": 1.05, "threads": [2, 4, 24], "metrics": ["op:demo16@*"]}
}
